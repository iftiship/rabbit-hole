{
  "name": "rabbit-hole",
  "version": "1.0.0",
  "description": "Rabbit Hole - Interactive visual knowledge explorer",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "server": "npm run start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "client:dev": "npm run dev --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"npm run server:dev\" \"npm run client:dev\"",
    "build": "npm run build --prefix client",
    "start": "npm run start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
