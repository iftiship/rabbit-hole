# Rabbit Hole Environment Variables

# Backend Port (default: 5001)
PORT=5001

# Gemini API Key (get from https://aistudio.google.com/)
# If empty, Rabbit Hole runs in Demo Mode with rich curated sample datasets
GEMINI_API_KEY=

# Tavily Search API Key (get from https://tavily.com/)
# Used for live source retrieval and factual grounding
# If empty, fallback curated sources will be provided
TAVILY_API_KEY=
